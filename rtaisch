import os
from typing import List, Dict, Optional
from dataclasses import dataclass
from azure.search.documents import SearchClient
from azure.core.credentials import AzureKeyCredential
from openai import AzureOpenAI


@dataclass
class SearchResult:
    """Search result from Azure AI Search"""
    chunk_id: str
    document_name: str
    document_type: str
    blob_name: str
    content: str
    score: float
    reranker_score: Optional[float] = None
    captions: Optional[List[str]] = None
    page_number: Optional[int] = None
    section: Optional[str] = None
    
    def to_dict(self) -> Dict:
        """Convert to dictionary"""
        return {
            "chunk_id": self.chunk_id,
            "document_name": self.document_name,
            "document_type": self.document_type,
            "blob_name": self.blob_name,
            "content": self.content,
            "score": self.score,
            "reranker_score": self.reranker_score,
            "captions": self.captions,
            "page_number": self.page_number,
            "section": self.section
        }


class UnifiedPolicyRetriever:
    """
    Unified retrieval for all policy documents in a single index
    Supports filtering by document type, hybrid search, and semantic ranking
    """
    
    def __init__(
        self,
        search_service_endpoint: str,
        search_api_key: str,
        index_name: str,
        openai_api_key: str,
        openai_endpoint: str,
        openai_api_version: str = "2024-02-15-preview",
        embedding_deployment: str = "text-embedding-3-large"
    ):
        """
        Initialize unified retriever
        
        Args:
            search_service_endpoint: Azure AI Search endpoint
            search_api_key: Azure AI Search API key
            index_name: Name of the search index
            openai_api_key: Azure OpenAI API key
            openai_endpoint: Azure OpenAI endpoint
            openai_api_version: API version
            embedding_deployment: Embedding model deployment name
        """
        self.search_client = SearchClient(
            endpoint=search_service_endpoint,
            index_name=index_name,
            credential=AzureKeyCredential(search_api_key)
        )
        
        self.openai_client = AzureOpenAI(
            api_key=openai_api_key,
            api_version=openai_api_version,
            azure_endpoint=openai_endpoint
        )
        
        self.embedding_deployment = embedding_deployment
        self.index_name = index_name
        
        print(f"✓ Unified retriever initialized for index: {index_name}")
    
    def generate_embedding(self, text: str) -> List[float]:
        """Generate embedding for text using Azure OpenAI"""
        try:
            response = self.openai_client.embeddings.create(
                input=text,
                model=self.embedding_deployment
            )
            return response.data[0].embedding
        except Exception as e:
            print(f"Error generating embedding: {str(e)}")
            return []
    
    def hybrid_search(
        self,
        query: str,
        top_k: int = 10,
        document_types: Optional[List[str]] = None,
        document_names: Optional[List[str]] = None,
        use_semantic_ranking: bool = False,  # Changed default to False
        min_score: float = 0.0
    ) -> List[SearchResult]:
        """
        Hybrid search across all documents with optional filtering
        
        Args:
            query: Search query
            top_k: Number of results to return
            document_types: Filter by document types (e.g., ["Product Program Policy", "FAQ Document"])
            document_names: Filter by specific document names
            use_semantic_ranking: Use semantic L2 ranker
            min_score: Minimum score threshold
            
        Returns:
            List of SearchResult objects
        """
        print(f"\n🔍 Hybrid Search: '{query}'")
        
        # Generate query embedding
        query_vector = self.generate_embedding(query)
        
        if not query_vector:
            print("❌ Failed to generate query embedding")
            return []
        
        # Build filter expression
        filters = []
        if document_types:
            type_filters = " or ".join([f"document_type eq '{dt}'" for dt in document_types])
            filters.append(f"({type_filters})")
        
        if document_names:
            name_filters = " or ".join([f"document_name eq '{dn}'" for dn in document_names])
            filters.append(f"({name_filters})")
        
        filter_expression = " and ".join(filters) if filters else None
        
        if filter_expression:
            print(f"📋 Filters: {filter_expression}")
        
        # Perform hybrid search
        try:
            search_params = {
                "search_text": query,
                "vector_queries": [{
                    "kind": "vector",
                    "vector": query_vector,
                    "fields": "content_vector",
                    "k": top_k
                }],
                "filter": filter_expression,
                "select": ["chunk_id", "document_name", "document_type", 
                          "content", "page_number", "section"],
                "top": top_k,
                "query_type": "simple"
            }
            
            # Only add semantic ranking if explicitly requested
            # Note: Requires semantic configuration in the index
            if use_semantic_ranking:
                search_params["query_type"] = "semantic"
                search_params["semantic_configuration_name"] = "default-semantic-config"
                search_params["query_caption"] = "extractive"
            
            search_results = self.search_client.search(**search_params)
            
            results = []
            for result in search_results:
                # Get score
                score = result.get("@search.score", 0.0)
                reranker_score = result.get("@search.reranker_score")
                
                # Skip low-score results
                if score < min_score:
                    continue
                
                # Extract captions if available
                captions = []
                if hasattr(result, '@search.captions'):
                    for caption in result['@search.captions']:
                        captions.append(caption.text)
                
                search_result = SearchResult(
                    chunk_id=result.get("chunk_id", ""),
                    document_name=result.get("document_name", ""),
                    document_type=result.get("document_type", ""),
                    blob_name=result.get("blob_name", "N/A"),
                    content=result.get("content", ""),
                    score=score,
                    reranker_score=reranker_score,
                    captions=captions if captions else None,
                    page_number=result.get("page_number"),
                    section=result.get("section")
                )
                
                results.append(search_result)
            
            print(f"✓ Found {len(results)} results")
            return results
            
        except Exception as e:
            print(f"❌ Search error: {str(e)}")
            return []
    
    def search_by_document_type(
        self,
        query: str,
        document_type: str,
        top_k: int = 5
    ) -> List[SearchResult]:
        """
        Search within specific document type
        
        Args:
            query: Search query
            document_type: Type of document (e.g., "FAQ Document", "Product Program Policy")
            top_k: Number of results
            
        Returns:
            List of SearchResult objects
        """
        print(f"\n📑 Searching in: {document_type}")
        return self.hybrid_search(
            query=query,
            top_k=top_k,
            document_types=[document_type]
        )
    
    def search_specific_documents(
        self,
        query: str,
        document_names: List[str],
        top_k: int = 5
    ) -> List[SearchResult]:
        """
        Search within specific documents
        
        Args:
            query: Search query
            document_names: List of document names to search in
            top_k: Number of results
            
        Returns:
            List of SearchResult objects
        """
        print(f"\n📄 Searching in documents: {', '.join(document_names)}")
        return self.hybrid_search(
            query=query,
            top_k=top_k,
            document_names=document_names
        )
    
    def multi_document_search(
        self,
        query: str,
        top_k_per_type: int = 3
    ) -> Dict[str, List[SearchResult]]:
        """
        Search across all document types and return results grouped by type
        
        Args:
            query: Search query
            top_k_per_type: Number of results per document type
            
        Returns:
            Dictionary mapping document types to search results
        """
        print(f"\n🔍 Multi-document search: '{query}'")
        
        # Get all unique document types
        document_types = self.get_document_types()
        
        results_by_type = {}
        
        for doc_type in document_types:
            results = self.search_by_document_type(query, doc_type, top_k_per_type)
            if results:
                results_by_type[doc_type] = results
        
        print(f"\n✓ Found results in {len(results_by_type)} document types")
        return results_by_type
    
    def keyword_search(
        self,
        query: str,
        top_k: int = 10,
        document_types: Optional[List[str]] = None
    ) -> List[SearchResult]:
        """
        Keyword-only search (no vector)
        
        Args:
            query: Search query
            top_k: Number of results
            document_types: Optional filter by document types
            
        Returns:
            List of SearchResult objects
        """
        print(f"\n🔤 Keyword Search: '{query}'")
        
        filter_expression = None
        if document_types:
            type_filters = " or ".join([f"document_type eq '{dt}'" for dt in document_types])
            filter_expression = f"({type_filters})"
        
        try:
            search_results = self.search_client.search(
                search_text=query,
                filter=filter_expression,
                select=["chunk_id", "document_name", "document_type",
                       "content", "page_number", "section"],
                top=top_k
            )
            
            results = []
            for result in search_results:
                search_result = SearchResult(
                    chunk_id=result.get("chunk_id", ""),
                    document_name=result.get("document_name", ""),
                    document_type=result.get("document_type", ""),
                    blob_name=result.get("blob_name", "N/A"),
                    content=result.get("content", ""),
                    score=result.get("@search.score", 0.0),
                    page_number=result.get("page_number"),
                    section=result.get("section")
                )
                results.append(search_result)
            
            print(f"✓ Found {len(results)} results")
            return results
            
        except Exception as e:
            print(f"❌ Search error: {str(e)}")
            return []
    
    def get_document_types(self) -> List[str]:
        """Get all unique document types in the index"""
        try:
            # Use facets to get unique document types
            results = self.search_client.search(
                search_text="*",
                facets=["document_type"],
                top=0
            )
            
            doc_types = []
            if hasattr(results, 'get_facets'):
                facets = results.get_facets()
                if facets and "document_type" in facets:
                    doc_types = [facet["value"] for facet in facets["document_type"]]
            
            return doc_types
            
        except Exception as e:
            print(f"Error getting document types: {str(e)}")
            return []
    
    def get_all_documents(self) -> List[Dict]:
        """Get list of all documents in the index"""
        try:
            results = self.search_client.search(
                search_text="*",
                select=["document_name", "document_type"],
                top=100
            )
            
            documents = []
            seen = set()
            
            for result in results:
                doc_name = result.get("document_name", "")
                if doc_name and doc_name not in seen:
                    documents.append({
                        "document_name": doc_name,
                        "document_type": result.get("document_type", "")
                    })
                    seen.add(doc_name)
            
            return documents
            
        except Exception as e:
            print(f"Error getting documents: {str(e)}")
            return []
    
    def get_index_statistics(self) -> Dict:
        """Get statistics about the index"""
        try:
            # Get document count using search
            results = self.search_client.search(
                search_text="*",
                include_total_count=True,
                top=0
            )
            
            total_count = results.get_count() if hasattr(results, 'get_count') else 0
            
            # Get unique documents
            documents = self.get_all_documents()
            document_types = self.get_document_types()
            
            stats = {
                "index_name": self.index_name,
                "total_chunks": total_count,
                "unique_documents": len(documents),
                "document_types": len(document_types),
                "documents": documents,
                "types": document_types
            }
            
            return stats
            
        except Exception as e:
            print(f"Error getting statistics: {str(e)}")
            return {}


def print_search_results(results: List[SearchResult], show_full_text: bool = False):
    """Print search results in a formatted way"""
    
    if not results:
        print("\n❌ No results found")
        return
    
    print(f"\n{'='*70}")
    print(f"SEARCH RESULTS ({len(results)} found)")
    print(f"{'='*70}\n")
    
    for idx, result in enumerate(results, 1):
        print(f"[{idx}] {result.document_name}")
        print(f"    Type: {result.document_type}")
        print(f"    Score: {result.score:.4f}", end="")
        if result.reranker_score:
            print(f" | Reranker: {result.reranker_score:.4f}", end="")
        print()
        
        if result.page_number:
            print(f"    Page: {result.page_number}")
        if result.section:
            print(f"    Section: {result.section}")
        
        # Show captions if available
        if result.captions:
            print(f"    Caption: {result.captions[0][:150]}...")
        elif show_full_text:
            print(f"    Content: {result.content[:200]}...")
        else:
            print(f"    Content: {result.content[:150]}...")
        
        print()


